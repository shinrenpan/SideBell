{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ to continue" : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@以繼續"
          }
        }
      }
    },
    "%@, %@" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@, %2$@"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@，%@"
          }
        }
      }
    },
    "Acknowledged" : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已確認"
          }
        }
      }
    },
    "Acknowledgement sent" : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已送出確認"
          }
        }
      }
    },
    "Add" : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新增"
          }
        }
      }
    },
    "Add item" : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新增項目"
          }
        }
      }
    },
    "Add what this household actually needs. Changes appear on the grid right away." : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "加入這個家真正需要的項目。變更會立刻出現在格子上。"
          }
        }
      }
    },
    "Always first, cannot be removed" : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "永遠第一格，不可刪除"
          }
        }
      }
    },
    "Bluetooth is off. SideBell needs Bluetooth to connect. Please turn it on to continue." : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "藍牙已關閉。SideBell 需要藍牙才能連線，請開啟後再繼續。"
          }
        }
      }
    },
    "Calls" : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "呼叫"
          }
        }
      }
    },
    "Calls appear here after the patient taps a cell." : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "患者按下格子後，呼叫會出現在這裡。"
          }
        }
      }
    },
    "Calls can be sent right now" : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目前可以送出呼叫"
          }
        }
      }
    },
    "Calls cannot be sent; the caregiver is out of range" : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目前無法送出呼叫，照顧者不在範圍內"
          }
        }
      }
    },
    "Calls from the patient are coming through" : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目前收得到患者的呼叫"
          }
        }
      }
    },
    "Calls from the patient cannot come through; the patient is out of range" : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目前收不到患者的呼叫，患者不在範圍內"
          }
        }
      }
    },
    "Cancel" : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "取消"
          }
        }
      }
    },
    "Cancels if you do not tap again within three seconds" : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "三秒內未再次按下即取消"
          }
        }
      }
    },
    "Caregiver" : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "照顧者端"
          }
        }
      }
    },
    "Carry with you to receive calls" : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "隨身攜帶，接收患者的呼叫"
          }
        }
      }
    },
    "Connected" : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已連線"
          }
        }
      }
    },
    "Current role" : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目前角色"
          }
        }
      }
    },
    "Discomfort" : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不舒服"
          }
        }
      }
    },
    "Dismiss" : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "關閉提示"
          }
        }
      }
    },
    "Edit call items" : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "編輯呼叫項目"
          }
        }
      }
    },
    "Enter a name for this item." : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請為這個項目輸入名稱。"
          }
        }
      }
    },
    "Got it" : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已收到"
          }
        }
      }
    },
    "I understand the notice above" : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我已了解上述說明"
          }
        }
      }
    },
    "Important notice. SideBell is a care assistance calling tool. It cannot replace emergency medical alert services. In an emergency, call your local emergency number. It works over Bluetooth, so its range is limited; it cannot send calls when the app is closed or the device runs out of battery." : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "重要說明。SideBell 是照護輔助呼叫工具，不能取代緊急醫療警報服務。遇到緊急狀況請撥打一一九，或當地緊急電話。本 App 透過藍牙運作，距離有限；App 被關閉或裝置沒電時無法傳送呼叫。"
          }
        }
      }
    },
    "Keep" : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保留"
          }
        }
      }
    },
    "Leaves this role and returns to the home screen, where you can choose Patient or Caregiver again" : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "離開目前角色並回到首頁，可重新選擇患者端或照顧者端"
          }
        }
      }
    },
    "Loading…" : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "載入中…"
          }
        }
      }
    },
    "More than three minutes have passed; the patient already sees no response" : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已超過三分鐘，患者端已顯示無人回應"
          }
        }
      }
    },
    "Name" : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "名稱"
          }
        }
      }
    },
    "New item" : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新增呼叫項目"
          }
        }
      }
    },
    "No calls yet" : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目前沒有呼叫"
          }
        }
      }
    },
    "No response" : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無人回應"
          }
        }
      }
    },
    "Not available right now. %@" : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目前無法選擇。%@"
          }
        }
      }
    },
    "Not connected" : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未連線"
          }
        }
      }
    },
    "Not selected" : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未選擇"
          }
        }
      }
    },
    "Opens the %@ screen" : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "開啟%@畫面"
          }
        }
      }
    },
    "Patient" : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "患者端"
          }
        }
      }
    },
    "Please confirm the notice above before choosing a role." : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請先確認上方說明，才能選擇角色。"
          }
        }
      }
    },
    "Prices come from the App Store, so this is the only screen that needs to go online. Calls and alerts keep working without it." : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "價格由 App Store 提供，因此這是全 App 唯一需要連網的畫面。呼叫與警報不受影響，沒有網路照樣運作。"
          }
        }
      }
    },
    "Remove" : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "刪除"
          }
        }
      }
    },
    "Remove this item?" : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要刪除這個項目嗎？"
          }
        }
      }
    },
    "Remove “%@”?" : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要刪除「%@」嗎？"
          }
        }
      }
    },
    "Rename" : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "重新命名"
          }
        }
      }
    },
    "Role" : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "角色"
          }
        }
      }
    },
    "Save" : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "儲存"
          }
        }
      }
    },
    "Sends an acknowledgement so the patient knows someone responded" : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "送出確認，患者會看到有人回應了"
          }
        }
      }
    },
    "Set up beside the patient to send calls" : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "架設在患者身邊，用來發出呼叫"
          }
        }
      }
    },
    "Settings" : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "設定"
          }
        }
      }
    },
    "SideBell" : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SideBell 隨身鈴"
          }
        }
      }
    },
    "SideBell is a care assistance calling tool. It cannot replace emergency medical alert services. In an emergency, call your local emergency number. It works over Bluetooth, so its range is limited; it cannot send calls when the app is closed or the device runs out of battery." : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SideBell 是照護輔助呼叫工具，不能取代緊急醫療警報服務。遇到緊急狀況請撥打 119 或當地緊急電話。本 App 透過藍牙運作，距離有限；App 被關閉或裝置沒電時無法傳送呼叫。"
          }
        }
      }
    },
    "SideBell is free, and supporting it unlocks nothing. Every feature works the same either way." : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SideBell 是免費的，支持不會解鎖任何東西。所有功能在支持前後完全一樣。"
          }
        }
      }
    },
    "SideBell is not allowed to use Bluetooth. Open Settings > SideBell to grant permission." : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "尚未允許 SideBell 使用藍牙。請到「設定 > SideBell」開啟藍牙權限。"
          }
        }
      }
    },
    "Support the developer" : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "支持開發者"
          }
        }
      }
    },
    "Supporting unlocks nothing. Every feature works the same either way." : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "支持不會解鎖任何東西。所有功能在支持前後完全一樣。"
          }
        }
      }
    },
    "Switch role" : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "切換角色"
          }
        }
      }
    },
    "Switching roles stops the current connection." : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "切換角色會停止目前的連線。"
          }
        }
      }
    },
    "Takes two taps to run, so it cannot be triggered by accident" : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "需要按兩次才會執行，以免誤觸"
          }
        }
      }
    },
    "Tap again" : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "再按一次"
          }
        }
      }
    },
    "Tap again to continue" : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "再按一次以繼續"
          }
        }
      }
    },
    "Tap an item to rename it. Use Edit to reorder or remove. Changes apply right away." : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "點選項目即可重新命名。調整順序或刪除請按「編輯」。變更立即生效。"
          }
        }
      }
    },
    "Tap to send a call" : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "點一下送出呼叫"
          }
        }
      }
    },
    "Thank you for your support" : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "謝謝你的支持"
          }
        }
      }
    },
    "That name is too long. Please use a shorter one." : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這個名稱太長，請改短一些。"
          }
        }
      }
    },
    "The acknowledgement did not go through — the patient's device is unreachable. Move closer and try again." : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "確認未送達——目前連不上患者的裝置，請靠近一點再試一次"
          }
        }
      }
    },
    "The acknowledgement did not go through — the two devices have not finished Bluetooth pairing." : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "確認未送達——兩台裝置尚未完成藍牙配對"
          }
        }
      }
    },
    "The acknowledgement did not go through. Please try again." : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "確認未送達，請再試一次"
          }
        }
      }
    },
    "The call items could not be loaded. Please reopen the app." : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法載入呼叫項目，請重新開啟 App。"
          }
        }
      }
    },
    "The change could not be saved. Please try again." : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "變更沒有儲存成功，請再試一次。"
          }
        }
      }
    },
    "The grid is full at %lld items. Remove one before adding another." : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "格子已達 %lld 項的上限。要再新增，請先刪掉一項。"
          }
        }
      }
    },
    "The more items there are, the longer the patient has to search for the one they want. Consider replacing one instead of adding another." : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "項目越多，患者尋找想按的那一格就越費力。可以考慮換掉現有的某一項，而不是再新增。"
          }
        }
      }
    },
    "The patient will no longer be able to ask for this." : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "患者將無法再用這一項求助。"
          }
        }
      }
    },
    "The purchase did not go through. Please try again." : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "購買未完成，請再試一次。"
          }
        }
      }
    },
    "These are one-time contributions. You can support again whenever you like." : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每一筆都是獨立的支持，隨時可以再來一次。"
          }
        }
      }
    },
    "This device does not support Bluetooth Low Energy, so SideBell cannot be used." : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此裝置不支援藍牙低功耗，無法使用 SideBell。"
          }
        }
      }
    },
    "This item cannot be removed. It is how the patient calls for help." : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這個項目不能刪除，它是患者求助的方式。"
          }
        }
      }
    },
    "This screen fits %lld items. Any more would not be visible to the patient — remove one to make room." : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這個畫面放得下 %lld 項。再多患者就看不到了——請先刪掉一項。"
          }
        }
      }
    },
    "This screen needs a network connection" : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這個畫面需要網路連線"
          }
        }
      }
    },
    "Try again" : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "重試"
          }
